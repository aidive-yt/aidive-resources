+++ b/test/payments.test.ts
@@ -0,0 +1,53 @@
+import { describe, expect, it } from "vitest";
+import { openStore } from "../src/store/json-store";
+import { seedCustomer, seedOpenInvoice, testApp } from "./helpers";
+
+describe("partial payments", () => {
+  it("accumulates payments and flips to paid at a zero balance", async () => {
+    const app = testApp();
+    const id = await seedOpenInvoice(app, { customerId: await seedCustomer(app), unitPrice: 10_000 });
+    expect((await app.handle("POST", `/invoices/${id}/payments`, { amount: 4_000 })).body).toMatchObject({
+      status: "open",
+      amountPaid: 4_000,
+      balance: 6_000,
+    });
+    const last = await app.handle("POST", `/invoices/${id}/payments`, { amount: 6_000 });
+    expect(last).toMatchObject({ status: 201, body: { status: "paid", amountPaid: 10_000, balance: 0 } });
+  });
+
+  it("rejects bad amounts and overpayments with 400", async () => {
+    const app = testApp();
+    const id = await seedOpenInvoice(app, { customerId: await seedCustomer(app), unitPrice: 10_000 });
+    for (const amount of [0, -1, 1.5, "10", undefined]) {
+      expect((await app.handle("POST", `/invoices/${id}/payments`, { amount })).status).toBe(400);
+    }
+    expect((await app.handle("POST", `/invoices/${id}/payments`, { amount: 10_001 })).status).toBe(400);
+  });
+
+  it("refuses payments on drafts, void and unknown invoices", async () => {
+    const app = testApp();
+    const customerId = await seedCustomer(app);
+    const draft = await app.handle("POST", "/invoices", {
+      customerId,
+      currency: "EUR",
+      lines: [{ description: "x", quantity: 1, unitPrice: 100 }],
+    });
+    expect((await app.handle("POST", `/invoices/${(draft.body as { id: string }).id}/payments`, { amount: 10 })).status).toBe(409);
+    const voided = await seedOpenInvoice(app, { customerId });
+    await app.handle("POST", `/invoices/${voided}/void`);
+    expect((await app.handle("POST", `/invoices/${voided}/payments`, { amount: 10 })).status).toBe(409);
+    expect((await app.handle("POST", "/invoices/inv_404/payments", { amount: 10 })).status).toBe(404);
+  });
+
+  it("keeps /pay consistent and reports balances, not totals", async () => {
+    const app = testApp(openStore());
+    const customerId = await seedCustomer(app);
+    const a = await seedOpenInvoice(app, { customerId, unitPrice: 10_000 });
+    const b = await seedOpenInvoice(app, { customerId, unitPrice: 5_000 });
+    await app.handle("POST", `/invoices/${a}/payments`, { amount: 2_500 });
+    expect((await app.handle("GET", "/reports/outstanding")).body).toMatchObject({ totals: { EUR: 12_500 } });
+    expect((await app.handle("POST", `/invoices/${a}/pay`)).body).toMatchObject({ status: "paid", amountPaid: 10_000, balance: 0 });
+    expect((await app.handle("GET", "/reports/outstanding")).body).toMatchObject({ totals: { EUR: 5_000 }, count: 1 });
+    expect(b).toBeTruthy();
+  });
+});
