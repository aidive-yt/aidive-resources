+/**
+ * v1 -> v2: invoices carry `payments`. Invoices paid before payments existed were paid in full:
+ * they get one payment of their total at `paidAt`, so their balance is zero.
+ */
+const v1ToV2: Migration = (data) => {
+  const invoices = (data.invoices as Record<string, unknown>[] | undefined) ?? [];
+  return {
+    ...data,
+    schemaVersion: 2,
+    invoices: invoices.map((inv) => {
+      if (Array.isArray(inv.payments)) return inv;
+      const invoice = inv as unknown as Invoice;
+      const payments =
+        invoice.status === "paid"
+          ? [{ amount: computeTotals(invoice).total, receivedAt: invoice.paidAt ?? invoice.issuedAt ?? invoice.createdAt }]
+          : [];
+      return { ...inv, payments };
+    }),
+  };
+};
+
 /** migrations[n] upgrades a file from version n to n + 1. */
 const migrations: Record<number, Migration> = {
   0: v0ToV1,
+  1: v1ToV2,
 };
 
